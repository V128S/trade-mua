# Copy to .env.local and fill in. Prod values live in Vercel project env.

# ── Supabase (Dashboard → Project Settings → API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (product sync) — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Product sync auth (/api/sync-products) ────────────────────────────────
# Bearer token the Google Apps Script webhook sends on POST
SYNC_SECRET=long-random-string
# Bearer token Vercel Cron sends on GET (set in Vercel project env)
CRON_SECRET=long-random-string

# ── Profitability calculator ──────────────────────────────────────────────
WHATTOMINE_API_KEY=your-whattomine-api-key

# ── Optional: director order notifications via Telegram ───────────────────
# Leave empty to skip notifications (checkout still works)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIRECTOR_CHAT_ID=

# ── Optional: customer order emails via Resend ────────────────────────────
# Leave empty to skip emails (checkout still works)
RESEND_API_KEY=

# ── Optional: set to 1 to log GA4 events to the console ───────────────────
NEXT_PUBLIC_ANALYTICS_DEBUG=
